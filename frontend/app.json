{
  "expo": {
    "name": "KingfoodWMS",
    "slug": "KingfoodWMS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kingfoodwms",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Sử dụng FaceID để đăng nhập nhanh vào ứng dụng Kingfood"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "permissions": [
          "android.permission.CAMERA",
          "android.permission.USE_BIOMETRIC",
          "android.permission.USE_FINGERPRINT"
        ]
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần quyền camera để quét mã barcode sản phẩm"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cần quyền camera để quét mã barcode"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cần quyền camera để chụp ảnh minh chứng"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      "expo-video",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sử dụng FaceID để đăng nhập nhanh vào ứng dụng Kingfood"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
